// Banco do sistema (PostgreSQL). O Prisma é usado SOMENTE para criar/versionar as tabelas (migrations);
// o backend Python acessa estas tabelas com SQL. Os nomes de tabelas e colunas (@@map) são os usados no backend.
//
// Regras de negócio refletidas no banco:
//  - cadastros não são excluídos: todos têm STATUS (ATIVO/INATIVO) para inativar e reativar;
//  - uma conta (movimentocontas) pode ter uma ou mais classificações (movimento_classificacao, N:N);
//  - uma conta pode ter uma ou mais parcelas (parcelacontas), cada uma com o seu vencimento.
//
// Mantenha em sincronia com o SCHEMA do SQLite local em backend/app/db.py (desenvolvimento e testes).

datasource db {
  provider = "postgresql"
}

enum TipoPessoa {
  CLIENTE
  FORNECEDOR
  FATURADO
}

enum TipoClassificacao {
  RECEITA
  DESPESA
}

enum TipoMovimento {
  PAGAR
  RECEBER
}

enum Status {
  ATIVO
  INATIVO
}

enum SituacaoParcela {
  ABERTA
  QUITADA
}

/// MANTER PESSOAS: fornecedor, cliente e faturado.
model Pessoa {
  id            Int        @id @default(autoincrement())
  tipo          TipoPessoa
  razao_social  String     @db.VarChar(255)
  fantasia      String?    @db.VarChar(255)
  /// CPF (11) ou CNPJ (14), somente dígitos.
  documento     String     @db.VarChar(14)
  status        Status     @default(ATIVO)
  data_cadastro DateTime   @default(now()) @db.Timestamptz(0)

  movimentos         MovimentoContas[] @relation("PessoaPrincipal")
  movimentosFaturado MovimentoContas[] @relation("PessoaFaturada")

  @@unique([tipo, documento])
  @@map("pessoas")
}

/// MANTER CLASSIFICAÇÃO: tipos de receita e de despesa.
model Classificacao {
  id            Int               @id @default(autoincrement())
  tipo          TipoClassificacao
  descricao     String            @db.VarChar(160)
  /// Descrição normalizada (sem acento/caixa): evita duplicatas como "Manutenção" e "MANUTENCAO".
  chave         String            @db.VarChar(160)
  status        Status            @default(ATIVO)
  data_cadastro DateTime          @default(now()) @db.Timestamptz(0)

  movimentos MovimentoClassificacao[]

  @@unique([tipo, chave])
  @@map("classificacao")
}

/// REGISTRAR CONTAS: contas a pagar (PAGAR) e a receber (RECEBER).
model MovimentoContas {
  id            Int           @id @default(autoincrement())
  tipo          TipoMovimento
  /// Fornecedor (PAGAR) ou cliente/faturado (RECEBER).
  pessoa_id     Int
  /// Destinatário da nota, quando houver.
  faturado_id   Int?
  numero_nota   String?       @db.VarChar(60)
  data_emissao  DateTime?     @db.Date
  descricao     String        @db.VarChar(500)
  valor_total   Decimal       @db.Decimal(14, 2)
  status        Status        @default(ATIVO)
  data_cadastro DateTime      @default(now()) @db.Timestamptz(0)

  pessoa         Pessoa                   @relation("PessoaPrincipal", fields: [pessoa_id], references: [id])
  faturado       Pessoa?                  @relation("PessoaFaturada", fields: [faturado_id], references: [id])
  classificacoes MovimentoClassificacao[]
  parcelas       ParcelaContas[]

  @@index([tipo])
  @@index([pessoa_id, numero_nota])
  @@map("movimentocontas")
}

/// Classificações de cada conta (uma ou mais).
model MovimentoClassificacao {
  movimento_id     Int
  classificacao_id Int

  movimento     MovimentoContas @relation(fields: [movimento_id], references: [id])
  classificacao Classificacao   @relation(fields: [classificacao_id], references: [id])

  @@id([movimento_id, classificacao_id])
  @@map("movimento_classificacao")
}

/// Parcelas de cada conta (uma ou mais, com vencimentos distintos).
model ParcelaContas {
  id              Int             @id @default(autoincrement())
  movimento_id    Int
  numero          Int
  identificacao   String          @db.VarChar(120)
  data_vencimento DateTime        @db.Date
  valor           Decimal         @db.Decimal(14, 2)
  situacao        SituacaoParcela @default(ABERTA)

  movimento MovimentoContas @relation(fields: [movimento_id], references: [id])

  @@unique([movimento_id, numero])
  @@map("parcelacontas")
}
