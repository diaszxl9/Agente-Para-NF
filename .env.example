# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NÃO deve ser versionado.

# A Gemini API Key NÃO é configurada aqui: o usuário a informa na tela da aplicação, após o login.
# Modelo usado na extração. Ajuste se o seu projeto tiver acesso a outro modelo.
GEMINI_MODEL=gemini-3.6-flash
# Limite de cada chamada ao Gemini e tempo máximo da extração inteira (chamadas + retentativas).
# Se aumentar GEMINI_TEMPO_MAXIMO_SECONDS, aumente também EXTRACTION_TIMEOUT_MS no frontend.
GEMINI_TIMEOUT_SECONDS=120
GEMINI_TEMPO_MAXIMO_SECONDS=240
# Tentativas em erros 5xx transitórios do Gemini (1 = sem retentativas: 1 chamada por extração).
GEMINI_MAX_TENTATIVAS=1
# Raciocínio ("thinking") do modelo: minimal/low/medium/high. Vazio = padrão do modelo (use vazio em modelos anteriores ao Gemini 3).
GEMINI_NIVEL_RACIOCINIO=minimal

# Origens permitidas no CORS (separadas por vírgula) e tamanho máximo do PDF.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Login da aplicação. Os valores abaixo são as credenciais de teste documentadas no README
# (deixar vazio também usa esses padrões). Em produção, defina valores próprios.
AUTH_USUARIO=professor
AUTH_SENHA=avaliacao123
# Segredo que assina as sessões de login. OBRIGATÓRIO em produção (senão as sessões caem a cada reinício).
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
AUTH_SECRET=
# Duração da sessão de login, em horas.
AUTH_SESSAO_HORAS=8

# Chave que protege a API (todas as rotas em /api, exceto /api/health).
# Vazio = API aberta, sem autenticação (padrão atual, use apenas em ambiente local/confiável).
# Definindo um valor, toda requisição deve enviar o header "X-API-Key" com o mesmo valor.
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
API_KEY=

# Limite de requisições ao endpoint de extração (que chama a API paga do Gemini).
# Sintaxe da lib "limits": "<quantidade>/<segundo|minuto|hora|dia>". Agrupado por API key
# quando API_KEY está configurada; senão, por IP.
RATE_LIMIT_EXTRACAO=5/minute
# Limites do login (por IP) e da validação da Gemini API Key.
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_VALIDACAO=20/minute
