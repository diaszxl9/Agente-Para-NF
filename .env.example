# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NÃO deve ser versionado.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Fica somente no backend.
GEMINI_API_KEY=
# Modelo usado na extração. Ajuste se o seu projeto tiver acesso a outro modelo.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=120

# MySQL (banco principal). Crie o schema antes: CREATE DATABASE gestao_financeira CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/gestao_financeira?charset=utf8mb4

# MongoDB (OPCIONAL). Deixe vazio para não usar; a extração funciona sem ele.
MONGODB_URL=
MONGODB_DB=gestao_financeira

# Origens permitidas no CORS (separadas por vírgula) e tamanho máximo do PDF.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10
