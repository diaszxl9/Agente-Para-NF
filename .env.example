# Copie este arquivo para ".env" (na raiz do projeto) e preencha os valores.
# O arquivo .env NÃO deve ser versionado.

# Chave da API do Google Gemini (https://aistudio.google.com/apikey). Fica somente no backend.
GEMINI_API_KEY=
# Modelo usado na extração. Ajuste se o seu projeto tiver acesso a outro modelo.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=120

# MySQL (banco principal). Crie o schema antes: CREATE DATABASE gestao_financeira CHARACTER SET utf8mb4;
DATABASE_URL=mysql+pymysql://USUARIO:SENHA@localhost:3306/gestao_financeira?charset=utf8mb4

# MongoDB (OPCIONAL). Deixe vazio para não usar; a extração funciona sem ele.
MONGODB_URL=
MONGODB_DB=gestao_financeira

# Origens permitidas no CORS (separadas por vírgula) e tamanho máximo do PDF.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=10

# Chave que protege a API (todas as rotas em /api, exceto /api/health).
# Vazio = API aberta, sem autenticação (padrão atual, use apenas em ambiente local/confiável).
# Definindo um valor, toda requisição deve enviar o header "X-API-Key" com o mesmo valor.
# Gere um valor aleatório forte, ex.: openssl rand -hex 32
API_KEY=

# Limite de requisições ao endpoint de extração (que chama a API paga do Gemini).
# Sintaxe da lib "limits": "<quantidade>/<segundo|minuto|hora|dia>". Agrupado por API key
# quando API_KEY está configurada; senão, por IP.
RATE_LIMIT_EXTRACAO=20/minute
